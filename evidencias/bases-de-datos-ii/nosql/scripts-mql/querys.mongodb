
db.usuarios.find({
    $and: [
      { edad: { $gte: 18 } },  // Edad mayor o igual a 18
      { ciudad: "Madrid" }
    ]
  });

  db.usuarios.find({
    $or: [
      { estado: "activo" },
      { ciudad: "Barcelona" }
    ]
  });

  
  db.usuarios.find({
    edad: { $gt: 20, $lt: 30 } // Edad mayor que 20 y menor que 30
  });

  db.usuarios.find({
    ciudad: { $in: ["Madrid", "Barcelona", "Valencia"] }
  });

  db.usuarios.find({
    estado: { $nin: ["inactivo", "suspendido"] }
  });

  db.usuarios.find({
    telefono: { $exists: true }
  });

  db.usuarios.find({
    hobbies: { $elemMatch: { $eq: "fútbol", $size: 2 } }
  });

  db.usuarios.find(
    { ciudad: "Madrid" }, // Filtro
    { nombre: 1, edad: 1 } // Proyección: devolver solo nombre y edad
  );

  
  db.usuarios.aggregate([
    { $group: { _id: "$ciudad", total: { $sum: 1 } } }
  ]);

  db.usuarios.aggregate([
    {
      $lookup: {
        from: "pedidos", // Colección a unir
        localField: "_id", // Campo local
        foreignField: "usuarioId", // Campo en la colección unida
        as: "pedidos" // Nombre del nuevo campo en la salida
      }
    }
  ]);

  
  db.usuarios.find({
    nombre: { $regex: /^A/, $options: 'i' } // 'i' para búsqueda insensible a mayúsculas
  });

  db.usuarios.find({
    $and: [
      { edad: { $gt: 18 } },
      { $or: [{ ciudad: "Madrid" }, { ciudad: "Barcelona" }] },
      { estado: { $ne: "inactivo" } }
    ]
  });
  
  