
db.nombreColeccion.updateMany(
    { ciudad: "Madrid" }, // Filtro
    { $set: { estado: "activo" } } // Actualización
  );

  db.nombreColeccion.updateMany(
    { edad: { $lt: 30 } }, // Filtro
    { $inc: { edad: 1 } } // Incrementar la edad en 1
  );

  db.nombreColeccion.updateMany(
    { categoria: "empleado" }, // Filtro
    { $set: { salario: 3000 } } // Establecer el salario a 3000
  );

  db.nombreColeccion.updateMany(
    { estado: "inactivo" }, // Filtro
    { $unset: { fechaDeBaja: "" } } // Eliminar el campo "fechaDeBaja"
  );

  db.nombreColeccion.updateMany(
    { departamento: "ventas" }, // Filtro
    {
      $set: {
        estado: "activo",
        fechaActualizacion: new Date() // Establecer la fecha de actualización
      }
    }
  );

  db.nombreColeccion.updateMany(
    { nombre: "Sofía" }, // Filtro
    { $push: { hobbies: "fotografía" } } // Añadir "fotografía" al array de hobbies
  );

  db.nombreColeccion.updateMany(
    { nombre: "Sofía" }, // Filtro
    { $pull: { hobbies: "deportes" } } // Eliminar "deportes" del array de hobbies
  );

  db.nombreColeccion.updateMany(
    { edad: { $lt: 18 } }, // Filtro
    { $set: { categoria: "menor" } } // Establecer la categoría como "menor"
  );
  