use ("db2_20242")

db.nombreColeccion.updateOne(
    { nombre: "Juan" }, // Filtro
    { $set: { edad: 31 } } // Actualización
  );

  db.nombreColeccion.updateOne(
    { nombre: "Ana" },
    { $inc: { edad: 1 } } // Incrementar la edad en 1
  );

  db.nombreColeccion.updateMany(
    { ciudad: "Madrid" },
    { $set: { estado: "activo" } } // Establecer el estado a "activo"
  );

  
  db.nombreColeccion.updateMany(
    { ciudad: "Madrid" },
    { $set: { estado: "activo" } } // Establecer el estado a "activo"
  );

  db.nombreColeccion.updateOne(
    { nombre: "Carlos" },
    { $set: { pais: "España" } } // Añadir el campo "pais"
  );

  db.nombreColeccion.updateOne(
    { nombre: "Patricia" },
    { $unset: { edad: "" } } // Eliminar el campo "edad"
  );
  
  
  db.nombreColeccion.updateOne(
    { nombre: "Sofía" },
    { $push: { hobbies: "arte" } } // Añadir un nuevo hobby al array
  );

  db.nombreColeccion.updateOne(
    { nombre: "Sofía" },
    { $pull: { hobbies: "deportes" } } // Eliminar "deportes" del array de hobbies
  );

  db.nombreColeccion.updateOne(
    { nombre: "Luis" },
    { $set: { edad: 28 } },
    { upsert: true } // Si no se encuentra, se crea un nuevo documento
  );

  
  
  